{
  "stream": {
    "name": "EVENTS",
    "description": "user activity",
    "subjects": ["events.*"],
    "retention": "limits",
    "storage": "memory",
    "discard": "old",
    "max_consumers": -1,
    "max_msgs": 10000,
    "max_bytes": -1,
    "max_msgs_per_subject": -1,
    "max_msg_size": -1,
    "max_age": 86400000000000,
    "num_replicas": 1,
    "allow_direct": true
  },
  "consumers": [
    {
      "durable_name": "sessions",
      "description": "builds user sessions",
      "deliver_policy": "all",
      "ack_policy": "explicit",
      "ack_wait": 30000000000,
      "max_deliver": 3,
      "replay_policy": "instant",
      "seed_ack": 9
    },
    {
      "durable_name": "search-insights",
      "filter_subject": "events.search",
      "deliver_policy": "all",
      "ack_policy": "explicit",
      "ack_wait": 30000000000,
      "max_deliver": 3,
      "replay_policy": "instant"
    }
  ],
