{
  "stream": {
    "name": "ORDERS",
    "description": "customer orders",
    "subjects": ["orders.>"],
    "retention": "limits",
    "storage": "file",
    "discard": "old",
    "max_consumers": -1,
    "max_msgs": -1,
    "max_bytes": -1,
    "max_msgs_per_subject": -1,
    "max_msg_size": -1,
    "max_age": 604800000000000,
    "duplicate_window": 120000000000,
    "num_replicas": 1,
    "allow_direct": true
  },
  "consumers": [
    {
      "durable_name": "fulfilment",
      "description": "ships orders in the EU",
      "filter_subject": "orders.eu.>",
      "deliver_policy": "all",
      "ack_policy": "explicit",
      "ack_wait": 30000000000,
      "max_deliver": 5,
      "replay_policy": "instant",
      "seed_ack": 6
    },
    {
      "durable_name": "billing",
      "description": "invoices every order",
      "deliver_policy": "all",
      "ack_policy": "explicit",
      "ack_wait": 30000000000,
      "max_deliver": -1,
      "replay_policy": "instant",
      "seed_ack": 14
    },
    {
      "durable_name": "analytics",
      "description": "revenue dashboards",
      "filter_subject": "orders.*.created",
      "deliver_policy": "all",
      "ack_policy": "none",
      "replay_policy": "instant"
    },
    {
      "durable_name": "us-warehouse",
      "filter_subject": "orders.us.>",
      "deliver_policy": "new",
      "ack_policy": "explicit",
      "ack_wait": 30000000000,
      "max_deliver": 5,
      "replay_policy": "instant"
    }
  ],
